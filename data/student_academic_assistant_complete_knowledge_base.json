  "inference_rules": [
    {
      "id": "R01",
      "name": "course_code_lookup",
      "condition": "COURSE_CODE recognized",
      "action": "retrieve course record"
    },
    {
      "id": "R02",
      "name": "course_name_lookup",
      "condition": "course name matches stored course title",
      "action": "retrieve course record"
    },
    {
      "id": "R03",
      "name": "day_period_lookup",
      "condition": "DAY and PERIOD recognized",
      "action": "retrieve timetable entry"
    },
    {
      "id": "R04",
      "name": "day_time_lookup",
      "condition": "DAY and TIME recognized",
      "action": "map time to period and retrieve timetable entry"
    },
    {
      "id": "R05",
      "name": "faculty_lookup",
      "condition": "course is known",
      "action": "retrieve assigned faculty"
    },
    {
      "id": "R06",
      "name": "syllabus_topic_lookup",
      "condition": "topic matches stored syllabus topic",
      "action": "return course and unit containing it"
    },
    {
      "id": "R07",
      "name": "unit_lookup",
      "condition": "course and unit recognized",
      "action": "return all topics in that unit"
    },
    {
      "id": "R08",
      "name": "faculty_profile_lookup",
      "condition": "faculty recognized",
      "action": "retrieve stored faculty profile"
    },
    {
      "id": "R09",
      "name": "mini_project_student_lookup",
      "condition": "student matches project member",
      "action": "return batch, domain and mentor"
    },
    {
      "id": "R10",
      "name": "calendar_lookup",
      "condition": "date recognized",
      "action": "check academic calendar event"
    },
    {
      "id": "R11",
      "name": "next_class",
      "condition": "NEXT_CLASS intent plus current date/time",
      "action": "find first applicable timetable period after current time"
    },
    {
      "id": "R12",
      "name": "holiday_override",
      "condition": "calendar marks date as holiday",
      "action": "report holiday instead of treating normal timetable as active"
    },
    {
      "id": "R13",
      "name": "ambiguous_faculty",
      "condition": "course has multiple assigned faculty and no period is specified",
      "action": "return all stored assigned faculty"
    },
    {
      "id": "R14",
      "name": "unknown_information",
      "condition": "requested information is absent",
      "action": "state that the information is not available in the stored academic data"
    }
  ]
