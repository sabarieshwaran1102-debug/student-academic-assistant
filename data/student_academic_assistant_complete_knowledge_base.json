    "22UMA301": {
      "title": "Probability and Statistics",
      "type": "Theory",
      "credits": 3,
      "hours": 45,
      "ltpc": "3-0-0-3",
      "faculty": [
        "Dr. R. Kulandilvelu"
      ],
      "prerequisite": "Knowledge of basic Probability",
      "units": {
        "I": {
          "title": "Probability and Random Variables",
          "hours": 9,
          "topics": [
            "Probability",
            "Conditional Probability",
            "Bayes theorem",
            "Discrete and Continuous Random Variables",
            "Moment generating functions (Definition only)",
            "Binomial distribution",
            "Poisson distribution",
            "Uniform distribution",
            "Exponential distribution",
            "Normal distribution"
          ]
        },
        "II": {
          "title": "Two-Dimensional Random Variables",
          "hours": 9,
          "topics": [
            "Joint distributions",
            "Marginal distributions",
            "Conditional distributions",
            "Covariance",
            "Correlation"
          ]
        },
        "III": {
          "title": "Testing of Hypothesis",
          "hours": 9,
          "topics": [
            "Sampling distributions",
            "Estimation of parameters",
            "Statistical hypothesis",
            "Large sample tests based on Normal distribution for single mean",
            "Small sample tests based on t, Chi-square and F distributions"
          ]
        },
        "IV": {
          "title": "Design of Experiments",
          "hours": 9,
          "topics": [
            "One way classifications",
            "Two way classifications",
            "Completely randomized design",
            "Randomized block design",
            "Latin square design"
          ]
        },
        "V": {
          "title": "Statistical Quality Control",
          "hours": 9,
          "topics": [
            "Control charts for measurements",
            "Mean chart X",
            "Range chart R",
            "Control charts for attributes",
            "p chart",
            "c chart",
            "np chart"
          ]
        }
      },
      "course_outcomes": [
        "Apply the concepts of random variables and distributions",
        "Use correlation techniques to study the properties of two-dimensional random variables",
        "Solve different types of large and small sample problems by testing of hypothesis",
        "Utilize the analysis of variance for experimental designs",
        "Solve the quality control problems using statistical techniques"
      ]
    },
    "22UAD301": {
